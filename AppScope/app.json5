{
  // 包名：tv.hm.o（与 TvBoxHarmony 一致）；显示名由 AppScope/resources/base/element/string.json 的 app_name 控制（多媒体）；APP ID：117619014743214665
  // 版本规则（定调）：versionName = 1.<MMDD>.<当天版次>，versionCode 为 versionName 去点拼接（如 1.1111.01 -> 1111101）
  "app": {
    "bundleName": "tv.hm.o",
    "vendor": "kandianshi",
    "versionCode": 1111308,
    "versionName": "1.1113.08",
    "buildVersion": "1111312",
    // 应用图标改为分层图（前景+背景 1024×1024，不自行裁圆角、不加内边距），
    // 规避 AGC 云测 7.1.1.4.3「单层图圆角 / 存在透明像素」不通过。
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "minAPIVersion": 23,
    "targetAPIVersion": 24
  }
}
